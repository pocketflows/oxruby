#!/usr/bin/env ruby
# frozen_string_literal: true

# Differential test: runs real RuboCop (from the target project's bundle) and
# oxcop over the same project, restricted to the cops oxcop has ported, and
# diffs their JSON reports.
#
#   script/compare_with_rubocop [PROJECT_DIR] [-- extra args for both tools]
#   ONLY=Style/Foo,Layout/Bar script/compare_with_rubocop   # just these cops
#
# PROJECT_DIR defaults to ../code, the sibling checkout used as our corpus.
# ONLY restricts the comparison to the given ported cops (script/land uses it
# for landings that only add or change cops).

require "json"
require "open3"
require "bundler"

root = File.expand_path("..", __dir__)
args = ARGV.dup
extra = (i = args.index("--")) ? args.slice!(i..)[1..] : []
project = File.expand_path(args.first || File.join(root, "..", "code"))
oxcop = ENV.fetch("OXCOP_BINARY") { File.join(root, "target", "release", "oxcop") }
abort "oxcop binary not found at #{oxcop}; run `cargo build --release`" unless File.executable?(oxcop)

ported, status = Open3.capture2(oxcop, "--show-ported-cops")
abort "could not list ported cops" unless status.success?
cops = ported.lines(chomp: true)
unless ENV["ONLY"].to_s.empty?
  cops &= ENV["ONLY"].split(",").map(&:strip)
  if cops.empty?
    puts "no ported cops in ONLY=#{ENV["ONLY"]}; nothing to compare", "mismatched files: 0"
    exit 0
  end
  warn "comparing only #{cops.join(", ")}"
end
only = ["--only", cops.join(","), "--format", "json", "--cache", "false", *extra]

def report(label, command, dir)
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  # Undo the version manager's per-process pins (rbenv puts the running
  # Ruby's bin directory first on PATH) so the project's .ruby-version applies.
  path = ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).grep_v(%r{/\.rbenv/versions/[^/]+/bin\z})
  env = { "PATH" => path.join(File::PATH_SEPARATOR), "RBENV_VERSION" => nil, "RBENV_DIR" => nil,
          "GEM_HOME" => nil, "GEM_PATH" => nil }
  stdout, stderr, status = Open3.capture3(env, *command, chdir: dir)
  elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
  if status.exitstatus.nil? || status.exitstatus > 1 || stdout.empty?
    abort "#{label} failed (#{status}):\n#{stderr}"
  end
  warn format("%-8s %6.2fs", label, elapsed)
  json = JSON.parse(stdout)
  json["files"].to_h { |file| [file["path"], file["offenses"].map { |o| o.except("corrected") }] }
end

expected = Bundler.with_unbundled_env { report("rubocop", ["bundle", "exec", "rubocop", *only], project) }
# oxcop runs through its Ruby launcher inside the project's bundle, as
# `bundle exec oxcop` would, so `plugins:` resolve to the bundle's gems. The
# launcher isn't in the project's Gemfile, so it's run as a plain script.
launcher = File.join(root, "gems", "oxcop", "exe", "oxcop")
actual = Bundler.with_unbundled_env do
  ENV["OXCOP_BINARY"] = oxcop
  report("oxcop", ["bundle", "exec", "ruby", launcher, *only], project)
end

only_rubocop = expected.keys - actual.keys
only_oxcop = actual.keys - expected.keys
mismatched = (expected.keys & actual.keys).reject { |path| expected[path] == actual[path] }

puts "files: rubocop=#{expected.size} oxcop=#{actual.size}"
puts "inspected only by rubocop (#{only_rubocop.size}):", only_rubocop.first(20).map { "  #{_1}" } if only_rubocop.any?
puts "inspected only by oxcop (#{only_oxcop.size}):", only_oxcop.first(20).map { "  #{_1}" } if only_oxcop.any?
mismatched.first(20).each do |path|
  puts "offenses differ in #{path}:"
  puts "  rubocop: #{JSON.generate(expected[path])}"
  puts "  oxcop:   #{JSON.generate(actual[path])}"
end
puts "mismatched files: #{mismatched.size}"
exit(only_rubocop.empty? && only_oxcop.empty? && mismatched.empty? ? 0 : 1)
