#!/usr/bin/env bash
# Land the current branch on main: rebase onto main, run the gates for what
# changed, then move main with a compare-and-swap (`git update-ref NEW OLD`).
# Landings take a lock (`land.lock` in the shared git dir) so a slow full
# gate isn't starved by faster ones; the swap still guards main, so main only
# ever fast-forwards to a gated commit.
#
#   script/land            # gate + land
#   script/land --dry-run  # gate only
#   FULL=1 script/land     # always run the full gates
set -euo pipefail

# The whole script is one function so bash has parsed all of it before the
# rebase below rewrites this file on disk.
main() {
cd "$(git rev-parse --show-toplevel)"
dry_run=false
[[ "${1:-}" == "--dry-run" ]] && dry_run=true

branch=$(git symbolic-ref --short HEAD)
if [[ "$branch" == "main" ]]; then
  echo "land: run this from your own branch, not main" >&2
  exit 2
fi
if [[ -n "$(git status --porcelain)" ]]; then
  echo "land: commit or discard your changes first" >&2
  exit 2
fi

# Diff the ported cops (or just $1, comma separated) against real RuboCop on
# ../code; any difference fails the gate.
compare() {
  # ../code relative to the main checkout (worktrees live in .worktrees/).
  local code out status=0
  code="$(cd "$(git rev-parse --git-common-dir)/../.." && pwd)/code"
  [[ -d "$code" ]] || return 0
  # Fails on mismatched offenses and on files only one side inspects.
  out=$(ONLY="$1" OXCOP_BINARY="$PWD/target/debug/oxcop" script/compare_with_rubocop "$code" 2>&1) || status=$?
  echo "land: compare_with_rubocop${1:+ ($1)}: $(tail -1 <<<"$out") (exit $status)"
  if ((status != 0)); then
    tail -40 <<<"$out" | cut -c1-400
    return 1
  fi
}

# gate [RANGE]: gate the files changed in RANGE (default: this branch).
gate() {
  local changed
  changed=$(git diff --name-only "${1:-main...HEAD}")
  if [[ -z "$changed" ]]; then
    echo "land: nothing to land"
    return 0
  fi

  echo "land: checking that every crate root forbids unsafe"
  for root in crates/*/src/lib.rs crates/*/src/main.rs; do
    [[ -f "$root" ]] || continue
    if ! grep -q '^#!\[forbid(unsafe_code)\]' "$root"; then
      echo "land: $root lacks #![forbid(unsafe_code)]" >&2
      return 1
    fi
  done

  cargo fmt --all --check

  local oxcop=false oxtree=false
  grep -qvE '^(crates/oxtree/|gems/oxtree/|rakelib/oxtree|script/compare_with_stree|docs/)' <<<"$changed" && oxcop=true
  grep -qE '^(crates/oxtree/|gems/oxtree/|rakelib/oxtree|script/compare_with_stree|Cargo\.(toml|lock))' <<<"$changed" && oxtree=true
  if [[ -n "${FULL:-}" ]]; then
    oxcop=true
    oxtree=true
  fi

  if $oxtree; then
    cargo clippy -p oxtree --all-targets -- -D warnings
    cargo test -p oxtree
  fi

  if $oxcop; then
    cargo clippy -p oxcop --all-targets -- -D warnings
    cargo test -p oxcop
    cargo build -p oxcop

    # Only cop files changed: run their own specs, and diff just those cops
    # against real RuboCop on ../code. Anything shared changed (mixins, ast/,
    # config, the shim, ...): run every ported spec and the full diff.
    local specs=() cop_files=() shared=false
    while IFS= read -r path; do
      # Only department directories hold cops; mixin/, correctors/, utils/ and
      # the like are shared, so changing them takes the full gate.
      if [[ "$path" =~ ^crates/oxcop/src/cop/(bundler|gemspec|layout|lint|metrics|migration|naming|security|style)/([a-z0-9_]+)\.rs$ && "${BASH_REMATCH[2]}" != "mod" ]]; then
        cop_files+=("${BASH_REMATCH[1]}/${BASH_REMATCH[2]}")
        local spec="spec/rubocop/cop/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}_spec.rb"
        [[ -f "$spec" ]] && specs+=("$spec")
        # Some cops split their spec (conditional_assignment_assign_*_spec.rb):
        # take prefixed files that describe this cop.
        local extra
        for extra in "spec/rubocop/cop/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"_*_spec.rb; do
          [[ -f "$extra" ]] || continue
          ruby -e 'c = File.read(ARGV[0])[/RSpec\.describe RuboCop::Cop::\w+::(\w+)/, 1].to_s
                   s = c.gsub(/([A-Z]+)([A-Z][a-z])/, "\\1_\\2").gsub(/([a-z\d])([A-Z])/, "\\1_\\2").downcase
                   exit(s == ARGV[1] ? 0 : 1)' "$extra" "${BASH_REMATCH[2]}" && specs+=("$extra")
        done
      elif [[ "$path" =~ ^docs/ ]]; then
        :
      else
        shared=true
      fi
    done <<<"$changed"

    if $shared || [[ -n "${FULL:-}" ]]; then
      bundle exec rspec
      compare ""
    elif ((${#cop_files[@]})); then
      if ((${#specs[@]})); then
        bundle exec rspec "${specs[@]}"
      fi
      # department/file_name -> Department/CopName, as the binary names them.
      local cops
      cops=$(target/debug/oxcop --show-ported-cops | ruby -rset -e '
        files = ARGV.to_set
        snake = ->(s) { s.gsub(/([A-Z]+)([A-Z][a-z])/, "\\1_\\2").gsub(/([a-z\d])([A-Z])/, "\\1_\\2").downcase }
        puts $stdin.each_line(chomp: true).select { |name| files.include?(snake.(name)) }.join(",")
      ' "${cop_files[@]}")
      if [[ -n "$cops" ]]; then
        compare "$cops"
      fi
    fi
  fi
}

$dry_run || acquire_lock

for attempt in 1 2 3 4 5 6 7 8; do
  previous=${base:-}
  base=$(git rev-parse main)
  if ! git rebase main; then
    git rebase --abort || true
    echo "land: rebase onto main conflicts; run 'git rebase main', resolve, then land again" >&2
    exit 1
  fi
  # On a retry, our changes already passed their gates on the previous main.
  # When main only gained cop files since, gating those cops on top of our
  # rebased branch covers the combination, so a full gate isn't starved by
  # a stream of cop landings.
  if [[ -n "$previous" && -z "${FULL:-}" ]] &&
    ! git diff --name-only "$previous" "$base" | grep -qvE '^(crates/oxcop/src/cop/(bundler|gemspec|layout|lint|metrics|migration|naming|security|style)/[a-z0-9_]+\.rs|docs/.*)$'; then
    echo "land: main gained only cops/docs since the last gate; gating those"
    gate "$previous..$base"
  else
    gate
  fi
  if $dry_run; then
    echo "land: gates passed (dry run, main not moved)"
    exit 0
  fi
  if git update-ref -m "land $branch" refs/heads/main HEAD "$base"; then
    echo "land: main is now $(git rev-parse --short HEAD) ($branch)"
    exit 0
  fi
  echo "land: main moved while gating (attempt $attempt); rebasing and retrying"
done
echo "land: gave up after repeated races; try again shortly" >&2
exit 1
}

# One landing at a time across all worktrees. mkdir is atomic; the owner
# file records the pid so a lock left by a killed landing is broken.
acquire_lock() {
  lock="$(cd "$(git rev-parse --git-common-dir)" && pwd)/land.lock"
  local waited=0 owner pid
  until mkdir "$lock" 2>/dev/null; do
    owner=$(cat "$lock/owner" 2>/dev/null || true)
    pid=${owner%% *}
    if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
      echo "land: breaking stale lock ($owner)"
      rm -rf "$lock"
      continue
    fi
    if ((waited % 60 == 0)); then
      echo "land: waiting for the landing lock (held by ${owner:-?})"
    fi
    sleep 5
    waited=$((waited + 5))
  done
  echo "$$ $(git symbolic-ref --short HEAD) $(date '+%H:%M:%S')" >"$lock/owner"
  trap 'rm -rf "$lock"' EXIT
}

main "$@"
exit $?
